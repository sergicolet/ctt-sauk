        816,
        816
      ],
      "id": "1f01ad47-9d66-41f1-b418-ba7369ea93c6",
      "name": "Call SubWf SNAPPY"
    },
    {
      "parameters": {
        "numberInputs": 4
      },
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        1040,
        528
      ],
      "id": "51cd6fab-9d34-4586-b500-bcd7320a8a00",
      "name": "Merge2"
    },
    {
      "parameters": {
        "jsCode": "// Añade metadatos de cliente a TODOS los items del Merge\nconst CLIENT_MAP = {\n  '48630': { client_name: 'HAMINOS',    internal_email: 'incidenciashaminos@gmail.com',         gmail_credential_name: 'HAMINOS',                       cca_zone: 'cca.z3@cttexpress.com' },\n  '47352': { client_name: 'SNAPPY',     internal_email: 'incidenciassnappyblue@gmail.com',       gmail_credential_name: 'SNAPPY',                        cca_zone: 'cca.z3@cttexpress.com' },\n  '47685': { client_name: 'MIESTERY',   internal_email: 'incidenciasamzdiscounts01@gmail.com',   gmail_credential_name: 'MIESTERY / SERVICE CORP WORLD', cca_zone: 'cca.z3@cttexpress.com' },\n  '45416': { client_name: 'KULTUDENDA', internal_email: 'incidenciaskulturdenda@gmail.com',      gmail_credential_name: 'KULTURDENDA',                   cca_zone: 'cca.z2@cttexpress.com' }\n};\nreturn $input.all().map(item => {\n  const s = item.json;\n  const meta = CLIENT_MAP[String(s.client_code)] || { client_name: 'UNKNOWN', internal_email: '', gmail_credential_name: '', cca_zone: 'cca.z3@cttexpress.com' };\n  return { json: { ...s, ...meta } };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1280,
        528
      ],
      "id": "enr-0001-0001-0001-000000000001",
      "name": "Code: Enriquecer Cliente"
    },
    {
      "parameters": {
        "jsCode": "const TERMINAL = new Set(['2100', '2310', '3000']);\n\nreturn $input.all().filter(item => {\n  const status = String(item.json.shipping_status_code || '').replace(/\"/g, '').trim();\n  if (!TERMINAL.has(status)) return true; // Estado activo → siempre procesar\n\n  // Estado terminal: solo procesar si tiene más de 1 bulto (puede haber bultos con incidencia)\n  const bultos = Array.isArray(item.json.items) ? item.json.items.length : 0;\n  return bultos > 1;\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1520,
        528
      ],
      "id": "flt-0001-0001-0001-000000000008",
      "name": "Filter: Estados Activos"
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        1760,
        528
      ],
      "id": "lop-0001-0001-0001-000000000009",
      "name": "Loop: Un envío a la vez"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "v-1",
              "name": "shipping_code",
              "value": "={{ $json.shipping_code }}",
              "type": "string"
            },
            {
              "id": "v-2",
              "name": "client_code",
              "value": "={{ $json.client_code }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1880,
        528
      ],
      "id": "set-tracking-vars",
      "name": "Set: Variables de Envío"
    },
    {
      "parameters": {
        "projectId": "ctt-dashboard",
        "collection": "incidencias",
        "documentId": "={{ $('Set: Variables de Envío').item.json.shipping_code.toString() }}"
      },
      "type": "n8n-nodes-base.googleFirebaseCloudFirestore",
      "typeVersion": 1.1,
      "position": [
        2000,
        528
      ],
      "id": "fbs-0001-0001-0001-000000000010",
      "name": "Firestore: Buscar Incidencia Previa",
      "alwaysOutputData": true,
      "retryOnFail": true,
      "credentials": {
        "googleFirebaseCloudFirestoreOAuth2Api": {
          "id": "EXM0epVP1YsMfolr",
          "name": "haminos"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Determina skip, force_internal y numero_avisos a partir del doc Firestore\nconst firestoreDoc = $input.item.json;\nconst shipment = $('Loop: Un envío a la vez').item.json;\nconst hoy = $now.toFormat('yyyy-MM-dd');\nconst ayer = $now.minus({days: 1}).toFormat('yyyy-MM-dd');\n\nconst is2500 = String(shipment.shipping_status_code || '') === '2500';\nconst docValido = firestoreDoc?.numero_envio || firestoreDoc?.shipping_code;\nconst doc = docValido ? firestoreDoc : null;\n\n// Normaliza fecha_procesado a YYYY-MM-DD independientemente del formato almacenado\nfunction normalizeFecha(f) {\n  if (!f) return '';\n  const s = String(f).substring(0, 10);\n  // Detect legacy DD-MM-YYYY format\n  if (/^\\d{2}-\\d{2}-\\d{4}$/.test(s)) {\n    const [d, m, y] = s.split('-');\n    return `${y}-${m}-${d}`;\n  }\n  return s; // Already YYYY-MM-DD\n}\n\nlet skip = false;\nlet force_internal = false;\nlet numero_avisos = 0;\n\nif (doc) {\n  const fecha = normalizeFecha(doc.fecha_procesado);\n  skip = !is2500 && fecha === hoy;\n  force_internal = !skip && (fecha === ayer || is2500);\n  numero_avisos = (parseInt(doc.numero_avisos) || 0);\n} else {\n  force_internal = is2500;\n}\n\nreturn {\n  json: {\n    ...shipment,\n    skip,\n    force_internal,\n    is_2500: is2500,\n    numero_avisos\n  }\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2240,
        528
      ],
      "id": "ctx-0001-0001-0001-000000000011",
      "name": "Code: Preparar Contexto"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "skip-cond-1",
              "leftValue": "={{ $json.skip }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        2480,
        528
      ],
      "id": "ifp-0001-0001-0001-000000000012",
      "name": "IF: ¿Ya Procesado Hoy?"
    },
    {
      "parameters": {
        "jsCode": "// Expande 1 envío en N items (uno por bulto/item)\nconst shipment = $input.first().json;\nconst items = shipment.items || [];\n\nif (items.length === 0) {\n  return [{ json: { current_item_code: shipment.shipping_code + '001' } }];\n}\n\nreturn items.map(item => ({\n  json: {\n    current_item_code: item.item_code\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2720,
        528
      ],
      "id": "blt-0001-0001-0001-000000000013",
      "name": "Code: Expandir Bultos"
    },
    {
      "parameters": {
        "url": "=https://api.cttexpress.com/integrations-info/trf/item-history-api/history/{{ $json.current_item_code }}",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "view",
              "value": "APITRACK"
            },
            {
              "name": "showItems",
              "value": "false"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + ($('Code: Preparar Contexto').item.json.client_code == '47352' ? $('Token CTT SNAPPY').first().json.access_token : $('Code: Preparar Contexto').item.json.client_code == '48630' ? $('Token CTT HAMINOS').first().json.access_token : $('Code: Preparar Contexto').item.json.client_code == '47685' ? $('Token CTT MIESTERY').first().json.access_token : $('Token CTT KULTUDENDA').first().json.access_token) }}"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        2960,
        528
      ],
      "id": "his-0001-0001-0001-000000000014",
      "name": "HTTP: Historial Bulto",
      "retryOnFail": true,
      "maxRetries": 3,
      "retryDelay": 5000
    },
    {
      "parameters": {
        "jsCode": "// Colapsa N bultos en 1 item ligero para la IA: { shipping_code, bultos[{ item_code, history }] }\nconst all = $input.all();\nif (all.length === 0) throw new Error('[Extraer Historial] Sin items');\n\nconst ctx = $('Code: Preparar Contexto').item.json;\n\nconst bultos = all.map(it => {\n  const httpResp = it.json;\n  const item_code = httpResp?.data?.shipping_history?.item_code || httpResp?.shipping_code || 'unknown';\n\n  let events = [];\n  if (httpResp?.data?.shipping_history?.events) {\n    events = httpResp.data.shipping_history.events;\n  } else if (Array.isArray(httpResp?.data?.shipping_history)) {\n    events = httpResp.data.shipping_history;\n  } else if (httpResp?.events) {\n    events = httpResp.events;\n  }\n\n  const history_text = events.map(e => {\n    const raw_date = e.event_date || e.item_event_date || '';\n    const date = raw_date ? raw_date.substring(0, 16).replace('T', ' ') : '????-??-?? ??:??';\n    const code = e.code || e.event_code || '????';\n    const desc = e.description || e.event_description || '';\n    const detail = e.detail?.External_event_text || e.detail?.item_event_text || '';\n    \n    // Filtro de detalles nulos o vacíos\n    const cleanDetail = (detail && detail !== 'null' && detail !== 'undefined' && detail !== '') ? ` - ${detail}` : '';\n    \n    return `${date} | [${code}] ${desc}${cleanDetail}`;\n  }).join('\\n');\n\n  // Determine the most recent event code (use max event_date to be safe)\n  let latestEvent = null;\n  for (const e of events) {\n    const d = e.event_date || e.item_event_date || '';\n    if (!latestEvent || d > (latestEvent.event_date || latestEvent.item_event_date || '')) {\n      latestEvent = e;\n    }\n  }\n  const shipping_status_code = latestEvent ? String(latestEvent.code || latestEvent.event_code || '') : '';\n\n  return {\n    item_code,\n    history: history_text,\n    shipping_status_code\n  };\n});\n\n// Ordenar por item_code para consistencia\nbultos.sort((a, b) => a.item_code.localeCompare(b.item_code));\n\nreturn [{\n  json: {\n    ...ctx,\n    bultos\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3200,
        528
      ],
      "id": "exh-0001-0001-0001-000000000015",
      "name": "Code: Extraer Historial"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.item.json;\nconst bultos = item.bultos || [];\nconst now = new Date();\n\nlet manifest_hours = 0;\nlet transit_hours = 0;\nlet delivery_hours = 0;\nlet stationary_hours = 0;\nlet last_event_date = null;\n\nbultos.forEach(b => {\n  const lines = (b.history || \"\").split('\\n').filter(Boolean);\n  const events = lines.map(line => {\n    const parts = line.split(' | ');\n    const dateStr = parts[0];\n    const codeMatch = parts[1]?.match(/\\[(\\d+)\\]/);\n    const code = codeMatch ? codeMatch[1] : null;\n    return { date: new Date(dateStr), code };\n  }).filter(e => !isNaN(e.date.getTime()));\n\n  if (events.length === 0) return;\n\n  const latest = events.reduce((max, e) => e.date > max.date ? e : max, events[0]);\n  if (!last_event_date || latest.date > last_event_date) last_event_date = latest.date;\n\n  const lastManifest = [...events].reverse().find(e => ['0000', '0030'].includes(e.code));\n  const lastTransit  = [...events].reverse().find(e => ['0900', '1000'].includes(e.code));\n  const lastDelivery = [...events].reverse().find(e => ['1200', '1500', '1600', '2400', '2600', '2700'].includes(e.code));\n  const lastStationary = [...events].reverse().find(e => ['1700', '1800'].includes(e.code));\n\n  const diffNow = (d) => d ? (now - d) / 3600000 : 0;\n\n  if (lastManifest) manifest_hours = Math.max(manifest_hours, diffNow(lastManifest.date));\n  if (lastTransit)  transit_hours  = Math.max(transit_hours,  diffNow(lastTransit.date));\n  if (lastDelivery) delivery_hours = Math.max(delivery_hours, diffNow(lastDelivery.date));\n  if (lastStationary) stationary_hours = Math.max(stationary_hours, diffNow(lastStationary.date));\n});\n\n// Precalcular incidencia activa: existe 1600/2400/2600/2700/0600 sin 1500/2000/2100 posterior\nconst INCIDENT_CODES = new Set(['1600','2400','2600','2700','0600']);\nconst RESOLUTION_CODES = new Set(['1500','2000','2100']);\nlet has_active_incident = false;\nlet active_incident_code = null;\n\nfor (const b of (item.bultos || [])) {\n  const lines = (b.history || '').split('\\n').filter(Boolean);\n  const evts = lines.map(l => {\n    const parts = l.split(' | ');\n    const m = parts[1]?.match(/\\[(\\w+)\\]/);\n    return m ? m[1] : null;\n  }).filter(Boolean);\n\n  let lastIncident = null;\n  for (const code of evts) {\n    if (INCIDENT_CODES.has(code)) lastIncident = code;\n    if (RESOLUTION_CODES.has(code)) lastIncident = null;\n  }\n  if (lastIncident) {\n    has_active_incident = true;\n    active_incident_code = lastIncident;\n    break;\n  }\n}\n\nreturn {\n  json: {\n    ...item,\n    manifest_hours: Number(manifest_hours.toFixed(1)),\n    transit_hours: Number(transit_hours.toFixed(1)),\n    delivery_hours: Number(delivery_hours.toFixed(1)),\n    stationary_hours: Number(stationary_hours.toFixed(1)),\n    h_en_estado: last_event_date ? Number(((now - last_event_date)/3600000).toFixed(1)) : 0,\n    has_active_incident,\n    active_incident_code\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3440,
        528
      ],
      "id": "sla-0001-0001-0001-000000000016",
      "name": "Code: Calcular SLA Horas"
    },
    {
      "parameters": {
        "jsCode": "// Descarta pedidos multi-bulto donde TODOS los bultos ya están en estado terminal.\n// Esto complementa el filtro temprano que los dejó pasar por tener items.length > 1.\nconst TERMINAL = new Set(['2000', '2100', '2310', '3000']);\nconst item = $input.item.json;\nconst bultos = item.bultos || [];\n\nif (bultos.length === 0) return [{ json: item }]; // Sin historial → dejar pasar\n\nconst allTerminal = bultos.every(b => {\n  const code = String(b.shipping_status_code || '').replace(/\"/g, '').trim();\n  return TERMINAL.has(code);\n});\n\nif (allTerminal) return []; // Todos entregados → descartar\nreturn [{ json: item }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3320,
        528
      ],
      "id": "fba-0001-0001-0001-000000000017",
      "name": "Code: Filtrar Bultos Activos"
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list",
          "cachedResultName": "GPT-4O-MINI"
        },
        "responses": {
          "values": [
            {
              "content": "=Envío: {{ $json.shipping_code }}\nReferencia cliente: {{ $json.client_references[0] }}\nCliente: {{ $json.client_name }}\nFecha/hora actual: {{ $now.toFormat('yyyy-MM-dd HH:mm') }} ({{ ['Lunes','Martes','Miércoles','Jueves','Viernes','Sábado','Domingo'][$now.weekday - 1] }})\n\n--- VALORES PRECALCULADOS (USA ESTOS DIRECTAMENTE, NO RECALCULES) ---\nHoras en grabación/pendiente (0000/0030): {{ $json.manifest_hours }}\nHoras en tránsito (0900/1000): {{ $json.transit_hours }}\nHoras en reparto (1200/1500): {{ $json.delivery_hours }}\nHoras estacionado (1700/1800): {{ $json.stationary_hours }}\nIncidencia activa (1600/2400/2600/2700/0600 sin resolución posterior): {{ $json.has_active_incident }}\nCódigo de incidencia activa: {{ $json.active_incident_code || 'ninguna' }}\n\n--- HISTORIALES DE BULTOS ---\n{{ $json.bultos.map(b => 'Item: ' + b.item_code + '\\nHistorial:\\n' + b.history).join('\\n\\n---\\n\\n') }}"
            },
            {
              "role": "system",
              "content": "Eres un auditor logístico de CTT Express. Analiza el historial y decide la acción correcta. RESPONDE SOLO CON JSON PURO, SIN MARKDOWN.\n\n### FUENTE DE VERDAD\nLee el historial cronológicamente. Los valores precalculados ya están calculados en JS — ÚSALOS DIRECTAMENTE, NO los recalcules.\n\n### VERIFICACIÓN EN ORDEN ESTRICTO\n\nPASO 0 — ESTADOS TERMINALES (prioridad máxima):\n¿El último evento de algún bulto es 2500, 2300 o 2310?\n- 2500 → notification_type: \"devolucion\". FIN.\n- 2300 → notification_type: \"punto_ctt\". FIN.\n- 2310 → notification_type: \"punto_ctt\". FIN.\n\nPASO 1 — INCIDENCIAS GRAVES (sin umbral de tiempo):\n¿Existe en el historial algún evento 1006, 1008 o 1012?\n- 1006 (daño) / 1008 (robo) / 1012 (extravío) → notification_type: \"siniestro\". FIN.\n\nPASO 2 — INCIDENCIA ACTIVA (usa el campo precalculado, NO analices el historial):\n¿has_active_incident es true?\n- active_incident_code = 0600 → notification_type: \"recogida_fallida\". FIN.\n- active_incident_code = 1600/2400/2600/2700 → notification_type: \"segundo_intento\". FIN.\n\nPASO 3 — UMBRALES DE TIEMPO (usa los valores precalculados):\n- manifest_hours > 24 y el último evento es 0000 → notification_type: \"pendiente\".\n- manifest_hours > 24 y el último evento es 0030 → notification_type: \"recogida_0030\".\n- transit_hours > 24 y NO existe ningún [1200] o [1500] en el historial → notification_type: \"agilizar_transito\".\n- delivery_hours > 24 → notification_type: \"agilizar_reparto\".\n- stationary_hours > 24 → notification_type: \"agilizar_reparto\".\n- Ninguno supera → notification_type: \"none\".\n\n### REGLAS ANTI-ALUCINACIÓN\n- NUNCA afirmes un evento si su código no aparece textualmente en el historial.\n- 71_INAT NO es una incidencia. Es gestión interna de CTT.\n- Si should_notify es false → notification_type DEBE ser \"none\".\n- Si should_notify es true → notification_type NUNCA puede ser \"none\".\n\n### SALIDA JSON (ÚNICO FORMATO VÁLIDO)\n{\n  \"analysis\": {\n    \"ultimo_estado\": \"código del último evento del bulto más relevante\",\n    \"item_afectado\": \"item_code del bulto con la incidencia, o null\",\n    \"justificacion\": \"explicación del paso seguido y por qué\"\n  },\n  \"decision\": {\n    \"is_incident\": boolean,\n    \"should_notify\": boolean,\n    \"notification_type\": \"none|pendiente|devolucion|siniestro|segundo_intento|recogida_fallida|agilizar_transito|agilizar_reparto|punto_ctt|recogida_0030\"\n  }\n}"
            }
          ]
        },
        "builtInTools": {},
        "options": {
          "temperature": 0.1
        }
      },
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.1,
      "position": [
        3680,
        528
      ],
      "id": "aia-0001-0001-0001-000000000017",
      "name": "AI: Analizar Historiales",
      "credentials": {
        "openAiApi": {
          "id": "1MaHDKdD55sbyLF8",
          "name": "haminos"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.item.json;\nconst ctx = $('Code: Extraer Historial').item.json;\n\nconst SEG = String(ctx.shipping_code || '');\nconst PED = String(ctx.client_references?.[0] || SEG);\nconst formatted_history = (ctx.bultos || []).map(b => 'Item: ' + b.item_code + '\\n' + b.history).join('\\n\\n---\\n\\n');\nconst bultos_raw = JSON.stringify(ctx.bultos || []);\n\n// --- Parsear respuesta IA ---\nconst aiText = raw.output?.[0]?.content?.[0]?.text || '{}';\nlet ai;\ntry {\n  ai = JSON.parse(aiText.replace(/```json|```/g, '').trim());\n} catch (e) {\n  ai = { analysis: { ultimo_estado: '', item_afectado: null, justificacion: 'parse_error: ' + e.message }, decision: { is_incident: false, should_notify: false, notification_type: 'none' } };\n}\n\nlet is_incident   = ai.decision?.is_incident   === true;\nlet should_notify = ai.decision?.should_notify === true;\nlet notification_type = ai.decision?.notification_type || 'none';\n\n// --- Estado actual desde historial (no de la API de lista) ---\nlet estado_actual = String((ctx.bultos && ctx.bultos[0]) ? ctx.bultos[0].shipping_status_code : (ctx.shipping_status_code || '')).replace(/[\"']/g, '').trim();\n\n// --- Override matemático SLA (garantía sin depender de la IA) ---\nconst isManifest   = estado_actual === '0000' || estado_actual === '0030';\nconst isTransit    = estado_actual === '0900' || estado_actual === '1000';\nconst isDelivery   = ['1200','1500','1600','2400','2600','2700'].includes(estado_actual);\nconst isStationary = estado_actual === '1700' || estado_actual === '1800';\n\nif (ctx.force_internal === true || ctx.has_active_incident ||\n  (isManifest   && (parseFloat(ctx.manifest_hours)   || 0) > 24) ||\n  (isTransit    && (parseFloat(ctx.transit_hours)    || 0) > 24) ||\n  (isDelivery   && (parseFloat(ctx.delivery_hours)   || 0) > 24) ||\n  (isStationary && (parseFloat(ctx.stationary_hours) || 0) > 24)\n) {\n  is_incident = true;\n  should_notify = true;\n  // Si la IA no asignó tipo, asignar uno de fallback según el override\n  if (notification_type === 'none') {\n    if (ctx.has_active_incident) {\n      const ac = ctx.active_incident_code;\n      notification_type = ac === '0600' ? 'recogida_fallida' : 'segundo_intento';\n    } else if (isManifest) {\n      notification_type = estado_actual === '0030' ? 'recogida_0030' : 'pendiente';\n    } else if (isTransit)    notification_type = 'agilizar_transito';\n    else if (isDelivery || isStationary) notification_type = 'agilizar_reparto';\n  }\n}\n\n// --- Routing: internal (envío directo) vs standard (borrador CCA) ---\nconst INTERNAL_TYPES = new Set(['pendiente','devolucion','siniestro','recogida_0030']);\nconst num_base = Math.min(parseInt(ctx.numero_avisos) || 0, 999);\n\nconst isImmediate = INTERNAL_TYPES.has(notification_type) || ctx.force_internal === true || (num_base >= 1 && is_incident);\n\nconst target_type = (should_notify && is_incident)\n  ? (isImmediate ? 'internal' : 'standard')\n  : 'none';\n\nconst INTERNAL = { '48630':'incidenciashaminos@gmail.com', '47352':'incidenciassnappyblue@gmail.com', '47685':'incidenciasamzdiscounts01@gmail.com', '45416':'incidenciaskulturdenda@gmail.com' };\nconst CCA      = { '48630':'cca.z3@cttexpress.com', '47352':'cca.z3@cttexpress.com', '47685':'cca.z3@cttexpress.com', '45416':'cca.z2@cttexpress.com' };\nconst to_email = target_type === 'internal' ? (INTERNAL[ctx.client_code] || 'alertas@sergi.com') : (CCA[ctx.client_code] || 'cca.z3@cttexpress.com');\n\n// --- Plantillas fijas según diagrama-flujo.txt ---\nconst TEMPLATES = {\n  pendiente:        { subject: `ALERTA INTERNA: Envío ${SEG} grabado sin recoger`,           body: `Hola, se ha detectado que el siguiente envío lleva más de 24 horas en estado 0000. Por favor, revisadlo.\\nPEDIDO: - ${PED}` },\n  devolucion:       { subject: `Devolución en proceso: ${PED}`,                              body: `Estimados, el siguiente pedido ha entrado en proceso de devolución. Iniciamos seguimiento manual.\\nCÓDIGO: - ${SEG}` },\n  siniestro:        { subject: `Apertura de siniestro: ${PED}`,                              body: `Hola CTT, solicitamos la apertura oficial de expediente de siniestro por pérdida/daño para el envío:\\nREFERENCIA: - ${SEG}. Quedamos a la espera del número de expediente.` },\n  segundo_intento:  { subject: `Incidencia en el envío ${PED}`,                              body: `Buenos días. Tras la incidencia en el primer intento, solicitamos automáticamente un segundo intento de reparto para el siguiente día hábil.\\nEXPEDICIÓN: - ${SEG}. Gracias.` },\n  recogida_fallida: { subject: `Incidencia en el envío ${PED}`,                              body: `Buenos días. Solicitamos que se reintente la recogida fallida del siguiente envío:\\nEXPEDICIÓN: - ${SEG}. Gracias.` },\n  agilizar_transito:{ subject: `Incidencia en el envío ${PED}`,                              body: `Buenos días. El envío ${SEG} lleva más de 24 horas en tránsito sin pasar a reparto. Solicitamos que salga a reparto el próximo día hábil. Gracias.` },\n  agilizar_reparto: { subject: `Incidencia en el envío ${PED}`,                              body: `Buenos días. El envío ${SEG} lleva más de 24 horas en reparto sin entregarse. Solicitamos que sea sacado nuevamente a reparto hoy mismo. Gracias.` },\n  punto_ctt:        { subject: `Envío en punto CTT: ${PED}`,                                 body: `Hola. Necesitamos la dirección detallada del punto de recogida para el siguiente envío:\\nEXPEDICIÓN: - ${SEG}. Gracias de antemano.` },\n  recogida_0030:    { subject: `Incidencia en el envío ${PED}`,                              body: `Buenos días. Solicitamos agilizar la recogida del siguiente envío que lleva más de 24 horas pendiente:\\nLISTADO DE ENVÍOS: - ${SEG}. Gracias.` },\n};\n\nconst plantilla = TEMPLATES[notification_type] || { subject: '', body: '' };\n\nconst nuevo_numero_avisos = num_base + ((should_notify && is_incident && target_type !== 'none') ? 1 : 0);\n\nreturn {\n  json: {\n    ...ctx,\n    shipping_status_code: estado_actual || ctx.shipping_status_code,\n    formatted_history,\n    bultos_raw,\n    should_notify: should_notify && is_incident,\n    target_type,\n    notification_type,\n    incident_type:    notification_type,\n    incidencia:       notification_type,\n    email_subject:    plantilla.subject,\n    asunto:           plantilla.subject,\n    email_body:       plantilla.body,\n    cuerpo:           plantilla.body,\n    ai_justification: ai.analysis?.justificacion || '',\n    razon:            ai.analysis?.justificacion || '',\n    affected_bulto:   ai.analysis?.item_afectado || null,\n    bulto_afectado:   ai.analysis?.item_afectado || null,\n    to_email,\n    destinatario:     to_email,\n    numero_avisos:    nuevo_numero_avisos,\n    fecha_procesado:  $now.toFormat('yyyy-MM-dd HH:mm:ss'),\n    _docid:           SEG\n  }\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3920,
        528
      ],
