        "jsCode": "const raw = $input.first().json.body || $input.first().json;\nconst client_code = String(raw.client_code || '').trim();\n\nlet credencial = 'KULTUDENDA';\nif (client_code === '47352') credencial = 'SNAPPY';\nelse if (client_code === '48630') credencial = 'HAMINOS';\nelse if (client_code === '47685') credencial = 'MIESTERY';\n\nreturn {\n  shipping_code: String(raw.shipping_code || '').replace(/\"/g, '').trim(),\n  client_code,\n  credencial,\n  collection: raw.collection || 'ejecuciones',\n  doc_id: raw.doc_id\n};"
