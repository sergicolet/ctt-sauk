    {
      "parameters": {
        "jsCode": "const httpResp = $input.first().json;\nconst vars = $node[\"Prepare Vars\"].json;\n\n// Robust item extraction\nlet rawData = httpResp?.data?.shipping_history || httpResp?.data?.items_raw || [];\nconst items = Array.isArray(rawData) ? rawData : (rawData && typeof rawData === 'object' ? [rawData] : []);\n\nconst bultos = items.map(it => {\n  const events = it.events || [];\n  const history_text = events.map(e => {\n    const d = e.event_date || e.item_event_date || '';\n    const date = d ? d.substring(0,16).replace('T',' ') : '????';\n    const code = e.code || e.event_code || '????';\n    const desc = e.description || e.event_description || '';\n    return `${date} | [${code}] ${desc}`;\n  }).join('\\n');\n  \n  const latest = events.reduce((a, b) => {\n    const dateA = a.event_date || a.item_event_date || '';\n    const dateB = b.event_date || b.item_event_date || '';\n    return (dateB > dateA ? b : a);\n  }, events[0] || {});\n  \n  return {\n    item_code: it.item_code,\n    history: history_text,\n    shipping_status_code: String(latest.code || latest.event_code || '')\n  };\n});\n\nconst now = new Date();\n\nreturn {\n  doc_id: vars.doc_id,\n  collection: vars.collection,\n  estado: bultos[0]?.shipping_status_code || '',\n  bultos_historial_json: JSON.stringify(bultos),\n  fecha_procesado: now.toISOString().replace('T',' ').substring(0,16) + ' (Manual)',\n  razon: 'Actualización manual sin análisis IA.'\n};""
      },
