    {
      "parameters": {
        "jsCode": "const httpResp = $input.first().json;\nconst vars = $node[\"Prepare Vars\"].json;\n\nconst getDoc = $('Get Document').first().json || {};\nconst is_new = !getDoc.shipping_code && !getDoc.numero_envio;\n\n// Robust item extraction\nlet rawData = httpResp?.data?.shipping_history || httpResp?.data?.items_raw || [];\nconst items = Array.isArray(rawData) ? rawData : (rawData && typeof rawData === 'object' ? [rawData] : []);\n\nconst bultos = items.map(it => {\n  const events = it.events || [];\n  const history_text = events.map(e => {\n    const d = e.event_date || e.item_event_date || '';\n    const date = d ? d.substring(0,16).replace('T',' ') : '????';\n    const code = e.code || e.event_code || '????';\n    const desc = e.description || e.event_description || '';\n    return date + ' | [' + code + '] ' + desc;\n  }).join('\\n');\n  \n  const latest = events.reduce((a, b) => {\n    const dateA = a.event_date || a.item_event_date || '';\n    const dateB = b.event_date || b.item_event_date || '';\n    return (dateB > dateA ? b : a);\n  }, events[0] || {});\n  \n  return {\n    item_code: it.item_code,\n    history: history_text,\n    shipping_status_code: String(latest.code || latest.event_code || '')\n  };\n});\n\nconst now = new Date();\nconst fecha_actual = now.toISOString().replace('T',' ').substring(0,16);\n\nconst result = {\n  doc_id: vars.doc_id,\n  collection: vars.collection,\n  estado: String(bultos[0]?.shipping_status_code || ''),\n  shipping_code: String(vars.shipping_code),\n  numero_envio: String(vars.shipping_code),\n  tienda: vars.credencial,\n  client_code: String(vars.client_code),\n  bultos_historial_json: JSON.stringify(bultos),\n  fecha_procesado: fecha_actual + ' (Manual)',\n  razon: 'Actualizacion manual sin analisis IA.'\n};\n\nif (is_new) {\n  result.fecha_creacion = fecha_actual;\n}\n\nreturn result;"
      },
