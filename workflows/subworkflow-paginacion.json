    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\n// Forzamos que lastPage sea un número válido\nconst lastPage = Math.max(Number(item.pagination?.page_offsets?.last || 1), 1);\n\n// BUGFIX: Obtenemos el center_code directamente del nodo Loop.\n// Obtenerlo de item.data[0] es peligroso porque puede venir vacío\nlet centerCode = '';\ntry {\n  centerCode = $('3.LoopTiendas_Sub').first().json.center_code;\n} catch(e) {\n  centerCode = item.data?.[0]?.client_center_code || '';\n}\n\nconst pages = [];\nfor (let i = 2; i <= lastPage; i++) {\n  pages.push({ json: { page: i, center_code: centerCode } });\n}\nreturn pages;"
      },
