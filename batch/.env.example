# ───────────────────────────────────────────────────────────────────
# Plantilla de credenciales para pruebas LOCALES del batch.
# Copia este archivo a  .env  (mismo directorio) y rellena los valores.
# El .env NO se sube a Cloud Run; allí las vars vienen de Secret Manager.
# ───────────────────────────────────────────────────────────────────

# 1) OpenAI (IA de decisión). Imprescindible para decidir igual que n8n.
OPENAI_API_KEY=

# 2) Gmail por cliente. Necesario para crear drafts / enviar emails.
#    client_id y client_secret los tienes; el refresh_token se saca con:
#       node get-gmail-token.mjs <CLIENT_ID> <CLIENT_SECRET>
GMAIL_HAMINOS_CLIENT_ID=
GMAIL_HAMINOS_CLIENT_SECRET=
GMAIL_HAMINOS_REFRESH_TOKEN=

GMAIL_SNAPPY_CLIENT_ID=
GMAIL_SNAPPY_CLIENT_SECRET=
GMAIL_SNAPPY_REFRESH_TOKEN=

GMAIL_MIESTERY_CLIENT_ID=
GMAIL_MIESTERY_CLIENT_SECRET=
GMAIL_MIESTERY_REFRESH_TOKEN=

GMAIL_KULTUDENDA_CLIENT_ID=
GMAIL_KULTUDENDA_CLIENT_SECRET=
GMAIL_KULTUDENDA_REFRESH_TOKEN=

# 3) (Opcional) Secrets de CTT. Ya están hardcodeados como fallback en el código;
#    rellénalos solo si quieres rotarlos / sobreescribirlos.
# CTT_HAMINOS_CLIENT_ID=
# CTT_HAMINOS_CLIENT_SECRET=
# CTT_SNAPPY_CLIENT_ID=
# CTT_SNAPPY_CLIENT_SECRET=
# CTT_MIESTERY_CLIENT_ID=
# CTT_MIESTERY_CLIENT_SECRET=
# CTT_KULTUDENDA_CLIENT_ID=
# CTT_KULTUDENDA_CLIENT_SECRET=

# 4) (Opcional) Flags para pruebas. Por defecto el batch es seguro (no escribe/envía).
#    Descomenta para forzar comportamiento independientemente de config/batch_settings.
# DRY_RUN=true
# SEND_EMAILS=false
# BATCH_COLLECTION_SUFFIX=_batch_test
